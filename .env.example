# Prompt Share Configuration
# Copy to .env and fill in the required values.

# Port for the app
PORT=3000

# Address to bind to.
IP_ADDRESS=127.0.0.1

# Set to "production" when serving over HTTPS so cookies are marked Secure.
# NODE_ENV=production

# Tab shown first and selected when the upload page opens.
# Allowed: paste | upload. Default: paste.
DEFAULT_TAB=paste

# Largest prompt allowed, in  megabytes. Default: 1.
# Applies to pasted text, uploaded files and admin edits
MAX_UPLOAD_MB=1

# Time zone for dates on share and admin pages
TIME_ZONE=America/Toronto

# Path to the SQLite file (defaults to data/db.sqlite).
# DB_PATH=/data/db.sqlite

# Secret used to sign CSRF tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# Secret used to sign the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin (required) — log in at /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

