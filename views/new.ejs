<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/_head', { title: 'New prompt' }) %>
    <noscript><link rel="stylesheet" href="/css/noscript.css" /></noscript>
  </head>
  <body class="min-h-screen bg-paper text-ink font-sans antialiased">

    <main class="max-w-2xl mx-auto px-5 pb-20 pt-4">

      <div id="builder">
      <form id="form" method="post" action="/p/create" data-max-bytes="<%= maxBytes %>" data-max-mb="<%= maxMb %>" data-default-tab="<%= defaultTab %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="flex flex-wrap items-center justify-between gap-3 mt-7 mb-4">
          <%
            const TAB_LABELS = { paste: '▤ Paste', upload: '⬢ Upload' };
            const tabOrder = defaultTab === 'upload' ? ['upload', 'paste'] : ['paste', 'upload'];
          %>
          <div id="tabs" class="iso-card relative flex p-1 rounded-2xl bg-white text-[13px] font-bold">
            <div id="tab-pill" class="tab-pill absolute top-1 bottom-1 left-1 w-[88px] rounded-xl bg-ink"></div>
            <% tabOrder.forEach((name, i) => { %>
              <button type="button" id="tab-<%= name %>" class="relative z-10 w-[88px] py-2 rounded-xl <%= i === 0 ? 'text-white' : '' %>"><%= TAB_LABELS[name] %></button>
            <% }) %>
          </div>

          <div class="iso-card flex p-1 rounded-2xl bg-white text-[12px] font-bold font-mono" role="radiogroup" aria-label="Expires after">
            <% expiryChoices.forEach((choice) => { %>
              <label class="cursor-pointer">
                <input type="radio" name="expiry" value="<%= choice %>" class="peer sr-only" <%= choice === defaultExpiry ? 'checked' : '' %> />
                <span class="block px-3 py-2 rounded-xl peer-checked:bg-ink peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-iris"><%= choice %></span>
              </label>
            <% }) %>
          </div>

          <div class="iso-card font-mono text-[12px] bg-mint rounded-xl px-3 py-1.5 font-medium">
            <span id="size">0.0 KB · 0 chars</span>
          </div>
        </div>

        <div class="iso-card relative rounded-[20px] bg-white overflow-hidden">
          <div class="flex items-center gap-1.5 px-5 py-3 border-b-2 border-ink bg-mist">
            <span class="w-3 h-3 rounded-full bg-blush border border-ink"></span>
            <span class="w-3 h-3 rounded-full bg-sun border border-ink"></span>
            <span class="w-3 h-3 rounded-full bg-mint border border-ink"></span>
            <span class="ml-auto font-mono text-[11px] opacity-60">PROMPT / NEW</span>
          </div>

          <div id="pane-paste"<%- defaultTab === 'upload' ? ' class="hidden"' : '' %>>
            <textarea id="input" name="content" rows="10" placeholder="Drop your Prompt..." class="w-full bg-transparent p-6 font-mono text-[14px] leading-[1.8] placeholder:text-slate-400 resize-y min-h-[280px] focus:outline-none"></textarea>
          </div>

          <div id="pane-upload"<%- defaultTab === 'upload' ? '' : ' class="hidden"' %>>
            <label id="drop" class="iso-card block m-4 rounded-2xl bg-[#F8FAFF] cursor-pointer transition-all">
              <input id="file" type="file" accept=".txt,.md,text/plain,text/markdown" class="hidden" />
              <div class="py-12 text-center px-6">
                <div class="iso-block mx-auto mb-3 w-16 h-10 bg-iris border-2 border-ink rounded-md"></div>
                <p class="font-bold text-[15px]">Drop your prompt file</p>
                <p class="text-[13px] opacity-60 mt-1 font-mono">.txt .md — max <%= maxMb %>MB</p>
                <p id="filename" class="font-mono text-[12px] mt-2 text-[#4a67d6]"></p>
              </div>
            </label>
            <pre id="preview" class="hidden mx-4 mb-4 p-4 rounded-xl bg-ink text-[#E9EEF8] font-mono text-[13px] leading-6 whitespace-pre-wrap max-h-[26vh] overflow-y-auto"></pre>
          </div>

          <div class="border-t-2 border-ink bg-mist p-3 flex gap-2">
            <button type="submit" id="share-btn" class="iso-btn flex-1 bg-sun font-bold text-[14px] py-3 rounded-xl disabled:opacity-40">Share prompt</button>
            <button type="button" id="clear-btn" class="iso-btn px-4 text-[13px] font-bold bg-white rounded-xl">Clear</button>
          </div>
        </div>
      </form>

      <div class="flex gap-2 justify-center mt-[-2px]">
        <div class="h-2 w-[96%] bg-white border-2 border-t-0 border-ink rounded-b-xl"></div>
      </div>
      <div class="flex justify-center">
        <div class="h-2 w-[92%] bg-[#E0E7FA] border-2 border-t-0 border-ink rounded-b-xl"></div>
      </div>
      </div>

      <div id="result" class="hidden mt-7">
        <div class="iso-card rounded-2xl bg-ink text-white p-2 pl-4 flex items-center gap-2">
          <label for="link" class="sr-only">Share link</label>
          <input id="link" type="text" readonly class="flex-1 min-w-0 bg-transparent font-mono text-[13px] text-sun focus:outline-none" />
          <button type="button" id="copy-link" class="iso-btn text-[13px] font-bold bg-mint text-black px-4 py-2 rounded-xl">Copy</button>
        </div>
      </div>
    </main>

    <%- include('partials/_toast', { message: 'Prompt shared ✓' }) %>

    <script src="/js/ui.js"></script>
    <script src="/js/app.js"></script>
  </body>
</html>
