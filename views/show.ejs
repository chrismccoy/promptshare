<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/_head', { title: prompt.promptLabel, noindex: true }) %>
  </head>
  <body class="min-h-screen bg-paper text-ink font-sans antialiased">

    <main class="max-w-2xl mx-auto px-5 pb-20 pt-4">
      <div class="flex flex-wrap items-center justify-between gap-3 mt-7 mb-4">
        <div class="iso-card font-mono text-[12px] bg-mint rounded-xl px-3 py-1.5 font-medium">
          <span id="size"><%= prompt.sizeSummary %></span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <% if (prompt.editedText) { %>
            <div id="edited" class="iso-card font-mono text-[12px] bg-white rounded-xl px-3 py-1.5"><%= prompt.editedText %></div>
          <% } %>
          <div class="iso-card font-mono text-[12px] bg-white rounded-xl px-3 py-1.5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blush border border-ink"></span>
            <span id="expiry"><%= prompt.expiresText %></span>
          </div>
        </div>
      </div>

      <div class="iso-card relative rounded-[20px] bg-white overflow-hidden">
        <div class="flex items-center gap-1.5 px-5 py-3 border-b-2 border-ink bg-mist">
          <span class="w-3 h-3 rounded-full bg-blush border border-ink"></span>
          <span class="w-3 h-3 rounded-full bg-sun border border-ink"></span>
          <span class="w-3 h-3 rounded-full bg-mint border border-ink"></span>
          <span class="ml-auto font-mono text-[11px] opacity-60" id="prompt-id"><%= prompt.promptLabel %></span>
        </div>

        <pre id="prompt" class="p-6 font-mono text-[14px] leading-[1.8] whitespace-pre-wrap break-words prompt-scroll max-h-[60vh] overflow-y-auto"><%= prompt.content %></pre>

        <div class="border-t-2 border-ink bg-mist p-3 flex gap-2">
          <button type="button" id="copy-btn" class="iso-btn flex-1 bg-sun font-bold text-[14px] py-3 rounded-xl">
            <span id="copy-label">Copy prompt</span>
          </button>
          <a id="raw-btn" href="/p/<%= prompt.key %>.md" target="_blank" rel="noopener" class="iso-btn inline-flex items-center px-4 text-[13px] font-bold bg-white rounded-xl">Raw</a>
        </div>
      </div>

      <div class="flex gap-2 justify-center mt-[-2px]">
        <div class="h-2 w-[96%] bg-white border-2 border-t-0 border-ink rounded-b-xl"></div>
      </div>
      <div class="flex justify-center">
        <div class="h-2 w-[92%] bg-[#E0E7FA] border-2 border-t-0 border-ink rounded-b-xl"></div>
      </div>
    </main>

    <%- include('partials/_toast', { message: 'Copied ✓' }) %>

    <script src="/js/ui.js"></script>
    <script src="/js/share.js"></script>
  </body>
</html>
