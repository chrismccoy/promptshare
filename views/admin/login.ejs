<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/_head', { title: 'Admin login', noindex: true }) %>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-slate-50 px-4 font-ui text-slate-900 antialiased">
    <main class="w-full max-w-sm">
      <div class="mb-6 flex items-center justify-center gap-2 font-semibold">
        <span class="flex h-9 w-9 items-center justify-center rounded-md bg-indigo-600 text-white">◧</span>
        Prompt Share admin
      </div>
      <form method="post" action="/admin/login" class="dash-card space-y-4 p-6">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <h1 class="text-lg font-semibold">Sign in</h1>
        <% if (error) { %>
          <p class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"><%= error %></p>
        <% } %>
        <div>
          <label for="username" class="text-sm font-medium text-slate-700">Username</label>
          <input id="username" name="username" autocomplete="username" required class="dash-input mt-1" />
        </div>
        <div>
          <label for="password" class="text-sm font-medium text-slate-700">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required class="dash-input mt-1" />
        </div>
        <button type="submit" class="dash-btn-primary w-full">Sign in</button>
      </form>
    </main>
  </body>
</html>
