<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/_head', { title: heading, noindex: true }) %>
  </head>
  <body class="min-h-screen bg-paper text-ink font-sans antialiased">
    <%- include('partials/_nav') %>
    <main class="max-w-2xl mx-auto px-5 pb-20 pt-10">
      <div class="iso-card rounded-[20px] bg-white p-8 text-center">
        <p class="font-mono text-[12px] opacity-60">ERROR / <%= code %></p>
        <h1 class="font-bold text-[30px] leading-tight mt-2"><%= heading %></h1>
        <p class="mt-3 text-[15px] opacity-80"><%= message %></p>
        <a href="/" class="iso-btn inline-block mt-6 bg-sun font-bold text-[13px] px-5 py-2.5 rounded-xl">+ New prompt</a>
      </div>
    </main>
  </body>
</html>
